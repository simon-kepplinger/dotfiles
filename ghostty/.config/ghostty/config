theme = GitHub Dark High Contrast
gtk-titlebar = false

background =#181c24
palette = 1=#ff6d8b

font-family = "MesloLGS NF"
font-size = 11

window-padding-x = 12
window-padding-y = 12

cursor-style = block
cursor-invert-fg-bg = true
shell-integration-features = no-cursor

clipboard-paste-protection = false

keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = alt+7=unbind
keybind = alt+8=unbind
keybind = alt+9=unbind
keybind = alt+0=unbind

# workaround to get ^1 to ^9 working in tmux
keybind = ctrl+1=csi:27;5;49~
keybind = ctrl+2=csi:27;5;50~
keybind = ctrl+3=csi:27;5;51~
keybind = ctrl+4=csi:27;5;52~
keybind = ctrl+5=csi:27;5;53~
keybind = ctrl+6=csi:27;5;54~
keybind = ctrl+7=csi:27;5;55~
keybind = ctrl+8=csi:27;5;56~
keybind = ctrl+9=csi:27;5;57~

# shift+enter as alt+enter, tmux passes it through and claude code takes it as newline
keybind = shift+enter=text:\x1b\r
